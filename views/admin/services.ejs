<div class="admin-header">
  <div>
    <h1 class="admin-title">🛠️ Services</h1>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">Manage your services offerings.</p>
  </div>
  <a href="/admin/services/add" class="btn btn-primary">
    <i class="ph ph-plus"></i> Add New Service
  </a>
</div>

<div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--border-radius); overflow: hidden;">
  <% if (services && services.length > 0) { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Icon</th>
        <th>Title</th>
        <th>Description</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% services.forEach(service => { %>
      <% const sId = service._id || service.id; %>
      <tr>
        <td style="font-size: 1.5rem;"><%= service.icon || '⚡' %></td>
        <td style="font-weight: 600; color: var(--text-primary);"><%= service.title %></td>
        <td style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= service.description %></td>
        <td>
          <span class="badge <%= service.active ? 'badge-success' : 'badge-secondary' %>">
            <%= service.active ? 'Active' : 'Inactive' %>
          </span>
        </td>
        <td>
          <div style="display: flex; gap: 0.5rem;">
            <a href="/services" class="btn btn-secondary btn-sm" target="_blank" title="View on Site">
              <i class="ph ph-eye"></i>
            </a>
            <a href="/admin/services/edit/<%= sId %>" class="btn btn-primary btn-sm" title="Edit">
              <i class="ph ph-pencil-simple"></i>
            </a>
            <form action="/admin/services/delete/<%= sId %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this service?')">
              <button type="submit" class="btn btn-sm" style="background: rgba(255,101,132,0.15); color: var(--secondary); border: 1px solid rgba(255,101,132,0.3); cursor: pointer;" title="Delete">
                <i class="ph ph-trash"></i>
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <div style="padding: 4rem; text-align: center; color: var(--text-muted);">
    <i class="ph ph-list-dashes" style="font-size: 3rem; margin-bottom: 1rem; display: block;"></i>
    <h3 style="margin-bottom: 0.5rem; font-size: 1.2rem;">No Services Yet</h3>
    <p style="margin-bottom: 1.5rem;">Add your first service to show on frontend.</p>
    <a href="/admin/services/add" class="btn btn-primary btn-sm"><i class="ph ph-plus"></i> Add Service</a>
  </div>
  <% } %>
</div>
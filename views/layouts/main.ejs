<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Ankit Chauhan - Professional CMS Developer specializing in WordPress, Headless CMS, and custom web solutions." />
  <title><%= title || 'Ankit Chauhan - CMS Developer' %></title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Icons (Phosphor) -->
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1/src/index.js" defer></script>

  <!-- Main CSS -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%236C63FF'/><text x='50%25' y='50%25' dominant-baseline='central' text-anchor='middle' font-family='Inter' font-weight='800' font-size='18' fill='white'>A</text></svg>" />
</head>
<body>
  <%- include('../partials/navbar') %>

  <!-- Flash Messages -->
  <div class="flash-container" id="flashContainer">
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="flash-message flash-success">
        <i class="ph ph-check-circle"></i>
        <%= success_msg %>
      </div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="flash-message flash-error">
        <i class="ph ph-warning-circle"></i>
        <%= error_msg %>
      </div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div class="flash-message flash-error">
        <i class="ph ph-x-circle"></i>
        <%= error %>
      </div>
    <% } %>
  </div>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Main JS -->
  <script src="/js/main.js"></script>
</body>
</html>

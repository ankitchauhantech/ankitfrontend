            </div>
            <div style="background: var(--dark-3); border: 1px solid var(--border); border-radius: 12px; padding: 1rem;">
              <span style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">Role</span>
              <p style="color: var(--text-primary); font-weight: 600; margin-top: 0.25rem;">Developer</p>
            </div>
            <div style="background: var(--dark-3); border: 1px solid var(--border); border-radius: 12px; padding: 1rem;">
              <span style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">Email</span>
              <p style="color: var(--primary); font-weight: 600; margin-top: 0.25rem;">ankitkrajput46@gmail.com</p>
            </div>
            <div style="background: var(--dark-3); border: 1px solid var(--border); border-radius: 12px; padding: 1rem;">
              <span style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">Location</span>

<%- include('../partials/header', {title: title}) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="card-tag"><%= post.category %></span>
        <h1 class="page-hero-title" style="max-width: 800px; margin-top: 1rem;"><%= post.title %></h1>
        <div class="post-meta mt-2">
          <span>✍️ <%= post.author_name || 'Ankit Chauhan' %></span>
          <span>📅 <%= new Date(post.created_at).toLocaleDateString('en-IN', {day:'numeric', month:'long', year:'numeric'}) %></span>
          <span>👁️ <%= post.views %> views</span>
        </div>
        <nav class="breadcrumb mt-2">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/blog">Blog</a>
          <span class="breadcrumb-sep">›</span>
          <span><%= post.title.substring(0, 40) %>...</span>
        </nav>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 320px; gap: 3rem; align-items: start;">
        <div>
          <img src="<%= post.image %>" alt="<%= post.title %>" class="blog-single-image" loading="lazy" />
          <div class="blog-content">
            <%- post.content %>
          </div>
          <% if (post.tags) { %>
          <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border);">
            <span style="color: var(--text-muted); font-size: 0.9rem; margin-right: 0.75rem;">Tags:</span>
            <% post.tags.split(',').forEach(function(tag) { %>
              <span class="tech-badge" style="margin: 0.25rem;"><%= tag.trim() %></span>
            <% }) %>
          </div>
          <% } %>
          <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border);">
            <h4 style="font-size: 1rem; margin-bottom: 1rem; color: var(--text-secondary);">Share this article:</h4>
            <div style="display: flex; gap: 0.75rem;">
              <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent('https://ankitchauhan.dev/blog/' + post.slug) %>" target="_blank" class="social-link">
                <i class="ph ph-twitter-logo"></i>
              </a>
              <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent('https://ankitchauhan.dev/blog/' + post.slug) %>&title=<%= encodeURIComponent(post.title) %>" target="_blank" class="social-link">
                <i class="ph ph-linkedin-logo"></i>
              </a>
            </div>
          </div>
        </div>

        <div>
          <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--border-radius); padding: 1.5rem; margin-bottom: 1.5rem;">
            <h4 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 1rem;">About The Author</h4>
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
              <div style="width: 56px; height: 56px; background: var(--gradient-1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; color: white; font-family: 'Outfit', sans-serif;">A</div>
              <div>
                <strong style="color: var(--text-primary);">Ankit Chauhan</strong>
                <p style="color: var(--text-muted); font-size: 0.82rem; margin: 0;">CMS Developer</p>
              </div>
            </div>
            <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.7;">Passionate CMS Developer sharing knowledge about WordPress, Headless CMS and web development.</p>
          </div>

          <% if (relatedPosts.length > 0) { %>
          <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--border-radius); padding: 1.5rem;">
            <h4 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 1.25rem;">Related Articles</h4>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <% relatedPosts.forEach(function(rPost) { %>
              <a href="/blog/<%= rPost.slug %>" style="display: flex; gap: 0.75rem; text-decoration: none; padding: 0.75rem; background: var(--dark-3); border-radius: 10px; border: 1px solid var(--border); transition: border-color 0.3s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
                <img src="<%= rPost.image %>" alt="<%= rPost.title %>" style="width: 64px; height: 64px; object-fit: cover; border-radius: 8px; flex-shrink: 0;" loading="lazy" />
                <div>
                  <h5 style="color: var(--text-primary); font-size: 0.88rem; line-height: 1.4; margin-bottom: 0.25rem;"><%= rPost.title.substring(0, 60) %>...</h5>
                  <span style="color: var(--text-muted); font-size: 0.78rem;">📅 <%= new Date(rPost.created_at).toLocaleDateString('en-IN', {month:'short', year:'numeric'}) %></span>
                </div>
              </a>
              <% }) %>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>

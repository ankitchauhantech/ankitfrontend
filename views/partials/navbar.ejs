<nav class="navbar" id="navbar">
  <div class="nav-container">
    <!-- Logo -->
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">AC</div>
      <div class="nav-logo-text">
        <span class="nav-logo-name">Ankit Chauhan</span>
        <span class="nav-logo-role">Freelancer</span>
      </div>
    </a>

    <!-- Nav Menu -->
    <ul class="nav-menu" id="navMenu">
      <li><a href="/" class="nav-link <%= activePage === 'home' ? 'active' : '' %>">Home</a></li>
      <li><a href="/about" class="nav-link <%= activePage === 'about' ? 'active' : '' %>">About</a></li>
      <li><a href="/services" class="nav-link <%= activePage === 'services' ? 'active' : '' %>">Services</a></li>
      <li><a href="/portfolio" class="nav-link <%= activePage === 'portfolio' ? 'active' : '' %>">Portfolio</a></li>
      <li><a href="/blog" class="nav-link <%= activePage === 'blog' ? 'active' : '' %>">Blog</a></li>
      <li><a href="/contact" class="nav-link <%= activePage === 'contact' ? 'active' : '' %>">Contact</a></li>
    </ul>

    <!-- Nav Actions -->
    <div class="nav-actions">
      <% if (user) { %>
        <div class="nav-user">
          <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <span><%= user.name.split(' ')[0] %></span>
        </div>
        <% if (user.role === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-primary btn-sm">
            <i class="ph ph-layout"></i> Admin
          </a>
        <% } %>
        <a href="/auth/logout" class="btn btn-secondary btn-sm">
          <i class="ph ph-sign-out"></i> Logout
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-secondary btn-sm">
          <i class="ph ph-sign-in"></i> Login
        </a>
        <a href="/auth/register" class="btn btn-primary btn-sm">
          <i class="ph ph-user-plus"></i> Register
        </a>
      <% } %>
    </div>

    <!-- Hamburger -->
    <button class="nav-hamburger" id="navHamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>
